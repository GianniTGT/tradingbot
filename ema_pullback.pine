// @version=6
// EMA 20/50/100/200 + Distanca — by GianniTGT
// Strategji: EMA20 Pullback Long (4h + Daily konfirmim)

indicator("EMA Sniper — GianniTGT", overlay=true, max_labels_count=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
proximity_pct  = input.float(0.5,  "EMA20 Touch Zone (%)",  group="Strategji", step=0.1)
show_labels    = input.bool(true,  "Trego Labels Entry",    group="Display")
show_zones     = input.bool(true,  "Trego EMA20 Zone",      group="Display")
show_ema50     = input.bool(true,  "Trego EMA 50",          group="Display")
show_ema100    = input.bool(true,  "Trego EMA 100",         group="Display")
show_ema200    = input.bool(true,  "Trego EMA 200",         group="Display")

// ─── EMA CALCULATIONS ────────────────────────────────────────────────────────
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

ema_rising  = ema20 > ema20[3]
ema_falling = ema20 < ema20[3]

// Distanca % nga çmimi → EMA20
dist_pct = (close - ema20) / ema20 * 100

// ─── ZONA TOUCH EMA20 ────────────────────────────────────────────────────────
touch_zone    = ema20 * (proximity_pct / 100)
low_near_ema  = low  <= ema20 + touch_zone and low  >= ema20 - touch_zone
high_near_ema = high >= ema20 - touch_zone and high <= ema20 + touch_zone
bounce_candle    = low_near_ema  and close > ema20 and open < close
rejection_candle = high_near_ema and close < ema20 and open > close

// ─── FILTRAT ─────────────────────────────────────────────────────────────────
rsi      = ta.rsi(close, 14)
vol_avg  = ta.sma(volume, 10)
vol_ok   = volume >= vol_avg * 0.6

daily_ema   = request.security(syminfo.tickerid, "D", ta.ema(close, 20))
daily_close = request.security(syminfo.tickerid, "D", close)
htf_long    = daily_close > daily_ema
htf_short   = daily_close < daily_ema

// ─── KUSHTET E HYRJES ────────────────────────────────────────────────────────
long_condition  = ema_rising  and close > ema20 and bounce_candle    and rsi < 65 and rsi > 40 and vol_ok and htf_long
short_condition = ema_falling and close < ema20 and rejection_candle and rsi > 35 and rsi < 60 and vol_ok and htf_short

// ─── PLOTS ───────────────────────────────────────────────────────────────────
// EMA 20 — Cyan (ndryshon ngjyrë sipas trendit)
ema20_color = ema_rising ? color.new(#00E5FF, 0) : ema_falling ? color.new(#FF1744, 0) : color.gray
plot(ema20,  "EMA 20",  color=ema20_color,              linewidth=2)
plot(show_ema50  ? ema50  : na, "EMA 50",  color=color.new(#FF9800, 0),  linewidth=1)
plot(show_ema100 ? ema100 : na, "EMA 100", color=color.new(#AB47BC, 0),  linewidth=1)
plot(show_ema200 ? ema200 : na, "EMA 200", color=color.new(#FFD600, 0),  linewidth=2)

// Zona EMA20 (shaded)
ema_up = plot(show_zones ? ema20 + touch_zone : na, color=color.new(color.orange, 90))
ema_dn = plot(show_zones ? ema20 - touch_zone : na, color=color.new(color.orange, 90))
fill(ema_up, ema_dn, color=color.new(color.orange, 88), title="EMA20 Zone")

// ─── SINJALET ────────────────────────────────────────────────────────────────
plotshape(long_condition,  style=shape.triangleup,   location=location.belowbar,
     color=color.new(#00C853,0), size=size.normal, text="LONG",  title="Long")
plotshape(short_condition, style=shape.triangledown, location=location.abovebar,
     color=color.new(#D50000,0), size=size.normal, text="SHORT", title="Short")

// ─── LABELS ENTRY ────────────────────────────────────────────────────────────
atr = ta.atr(14)
if long_condition and show_labels
    long_sl  = low  - atr * 0.1
    long_tp1 = close + (close - long_sl) * 2.0
    label.new(bar_index, low - atr,
         text = "LONG\nEntry: " + str.tostring(close,    "#.##") +
                "\nSL:    "     + str.tostring(long_sl,  "#.##") +
                "\nTP:    "     + str.tostring(long_tp1, "#.##") +
                "\nDist:  "     + str.tostring(dist_pct, "#.##") + "%",
         color=color.new(#00C853,10), textcolor=color.white,
         style=label.style_label_up, size=size.small)

if short_condition and show_labels
    short_sl  = high + atr * 0.1
    short_tp1 = close - (short_sl - close) * 2.0
    label.new(bar_index, high + atr,
         text = "SHORT\nEntry: " + str.tostring(close,     "#.##") +
                "\nSL:    "      + str.tostring(short_sl,  "#.##") +
                "\nTP:    "      + str.tostring(short_tp1, "#.##") +
                "\nDist:  "      + str.tostring(dist_pct,  "#.##") + "%",
         color=color.new(#D50000,10), textcolor=color.white,
         style=label.style_label_down, size=size.small)

// ─── BACKGROUND ──────────────────────────────────────────────────────────────
in_long_zone  = ema_rising  and low_near_ema  and close > ema20
in_short_zone = ema_falling and high_near_ema and close < ema20
bgcolor(in_long_zone  ? color.new(#00C853, 92) : na, title="Long Zone")
bgcolor(in_short_zone ? color.new(#D50000, 92) : na, title="Short Zone")

// ─── TABELA INFO (top-right) ─────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 9,
     border_width=1, border_color=color.new(color.gray,50),
     bgcolor=color.new(color.black, 60))

dist_color = dist_pct > 0 ? color.new(#00E5FF, 0) : color.new(#FF1744, 0)
dist_sign  = dist_pct > 0 ? "+" : ""

if barstate.islast
    // Header
    table.cell(t, 0, 0, "EMA SNIPER",   text_color=color.white,  bgcolor=color.new(#1565C0,20), text_size=size.small)
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.yellow, bgcolor=color.new(#1565C0,20), text_size=size.small)
    // Legjenda ngjyrash
    table.cell(t, 0, 1, "EMA 20",  text_color=color.new(#00E5FF,0), text_size=size.small)
    table.cell(t, 1, 1, str.tostring(ema20,  "#.##"), text_color=color.new(#00E5FF,0), text_size=size.small)
    table.cell(t, 0, 2, "EMA 50",  text_color=color.new(#FF9800,0), text_size=size.small)
    table.cell(t, 1, 2, str.tostring(ema50,  "#.##"), text_color=color.new(#FF9800,0), text_size=size.small)
    table.cell(t, 0, 3, "EMA 100", text_color=color.new(#AB47BC,0), text_size=size.small)
    table.cell(t, 1, 3, str.tostring(ema100, "#.##"), text_color=color.new(#AB47BC,0), text_size=size.small)
    table.cell(t, 0, 4, "EMA 200", text_color=color.new(#FFD600,0), text_size=size.small)
    table.cell(t, 1, 4, str.tostring(ema200, "#.##"), text_color=color.new(#FFD600,0), text_size=size.small)
    // Distanca
    table.cell(t, 0, 5, "Dist EMA20", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5, dist_sign + str.tostring(dist_pct, "#.##") + "%", text_color=dist_color, text_size=size.small)
    // RSI + Trend
    table.cell(t, 0, 6, "RSI(14)", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(rsi, "#.#"),
         text_color=rsi > 70 ? color.red : rsi < 30 ? color.green : color.white, text_size=size.small)
    table.cell(t, 0, 7, "4H Trend", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 7, ema_rising ? "▲ BULL" : ema_falling ? "▼ BEAR" : "── FLAT",
         text_color=ema_rising ? color.green : ema_falling ? color.red : color.gray, text_size=size.small)
    table.cell(t, 0, 8, "Daily EMA", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 8, htf_long ? "▲ BULL" : "▼ BEAR",
         text_color=htf_long ? color.green : color.red, text_size=size.small)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(long_condition,  "EMA20 Long",  "✅ {{ticker}} EMA20 Pullback LONG @ {{close}}")
alertcondition(short_condition, "EMA20 Short", "✅ {{ticker}} EMA20 Pullback SHORT @ {{close}}")
alertcondition(in_long_zone and not long_condition,  "EMA20 Watch Long",  "⚠️ {{ticker}} afër EMA20 — vëzhgo Long")
alertcondition(in_short_zone and not short_condition, "EMA20 Watch Short", "⚠️ {{ticker}} afër EMA20 — vëzhgo Short")
