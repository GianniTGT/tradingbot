// @version=6
// EMA 20 Pullback Strategy — by Gianni
// Monitors: BTC, SOL, ETH, BNB, ADA, XRP, DOT, LINK, MATIC, AVAX
// Timeframe: 4h primary (works on any TF)
// Logic: Long/Short entries on confirmed pullbacks to the 20 EMA

indicator("EMA 20 Pullback Strategy", overlay=true, max_labels_count=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
ema_len         = input.int(20,   "EMA Period",            group="Strategy")
proximity_pct   = input.float(0.5, "EMA Touch Zone (%)",   group="Strategy", step=0.1)
rsi_len         = input.int(14,   "RSI Period",            group="Filters")
rsi_long_max    = input.int(65,   "RSI Max for Long",      group="Filters")
rsi_short_min   = input.int(35,   "RSI Min for Short",     group="Filters")
vol_filter_pct  = input.float(80, "Min Volume % of Avg",   group="Filters", step=5)
vol_ma_len      = input.int(10,   "Volume MA Length",      group="Filters")
htf_enabled     = input.bool(true,"Daily TF Confirmation", group="Filters")
show_labels     = input.bool(true, "Show Entry Labels",    group="Display")
show_zones      = input.bool(true, "Show EMA Touch Zones", group="Display")

// ─── CALCULATIONS ─────────────────────────────────────────────────────────────
ema20      = ta.ema(close, ema_len)
rsi        = ta.rsi(close, rsi_len)
vol_avg    = ta.sma(volume, vol_ma_len)

// EMA slope — rising if current > 3 bars ago
ema_rising  = ema20 > ema20[3]
ema_falling = ema20 < ema20[3]

// Proximity: how close is the low/high to EMA20
touch_zone  = ema20 * (proximity_pct / 100)
low_near_ema  = low  <= ema20 + touch_zone and low  >= ema20 - touch_zone
high_near_ema = high >= ema20 - touch_zone and high <= ema20 + touch_zone

// Bounce candle (bullish): opens near or below EMA, closes above EMA
bounce_candle    = low_near_ema and close > ema20 and open < close

// Rejection candle (bearish): opens near or above EMA, closes below EMA
rejection_candle = high_near_ema and close < ema20 and open > close

// Volume confirmation
vol_ok = volume >= vol_avg * (vol_filter_pct / 100)

// ─── DAILY TF CONFIRMATION ───────────────────────────────────────────────────
daily_ema   = request.security(syminfo.tickerid, "D", ta.ema(close, ema_len))
daily_close = request.security(syminfo.tickerid, "D", close)

htf_long  = htf_enabled ? daily_close > daily_ema : true
htf_short = htf_enabled ? daily_close < daily_ema : true

// ─── ENTRY CONDITIONS ─────────────────────────────────────────────────────────
// LONG: uptrend on current TF and daily, price pulled back to EMA, bullish bounce
long_condition = ema_rising
             and close > ema20
             and bounce_candle
             and rsi < rsi_long_max
             and rsi > 40
             and vol_ok
             and htf_long

// SHORT: downtrend on current TF and daily, price pulled up to EMA, bearish rejection
short_condition = ema_falling
              and close < ema20
              and rejection_candle
              and rsi > rsi_short_min
              and rsi < 60
              and vol_ok
              and htf_short

// ─── STOP LOSS & TAKE PROFIT (displayed as labels) ───────────────────────────
atr = ta.atr(14)

long_sl  = low[0]  - (atr * 0.1)   // just below bounce candle low
long_tp1 = close + (close - long_sl) * 1.5
long_tp2 = close + (close - long_sl) * 3.0

short_sl  = high[0] + (atr * 0.1)  // just above rejection candle high
short_tp1 = close - (short_sl - close) * 1.5
short_tp2 = close - (short_sl - close) * 3.0

// ─── PLOTS ───────────────────────────────────────────────────────────────────
ema_color = ema_rising ? color.new(#00C853, 0) : ema_falling ? color.new(#D50000, 0) : color.gray
plot(ema20, "EMA 20", color=ema_color, linewidth=2)

// EMA Touch Zone (shaded band)
ema_upper = ema20 + touch_zone
ema_lower = ema20 - touch_zone
upper_band = plot(show_zones ? ema_upper : na, "EMA Zone Upper", color=color.new(color.orange, 90))
lower_band = plot(show_zones ? ema_lower : na, "EMA Zone Lower", color=color.new(color.orange, 90))
fill(upper_band, lower_band, color=color.new(color.orange, 88), title="EMA Touch Zone")

// ─── SIGNALS ─────────────────────────────────────────────────────────────────
plotshape(long_condition,  title="Long Entry",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00C853, 0), size=size.normal, text="LONG")

plotshape(short_condition, title="Short Entry",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#D50000, 0), size=size.normal, text="SHORT")

// ─── ENTRY LABELS WITH SL / TP ───────────────────────────────────────────────
if long_condition and show_labels
    lbl = label.new(bar_index, low - atr,
         text="LONG\nEntry: " + str.tostring(close,    "#.##") +
              "\nSL:    " + str.tostring(long_sl,  "#.##") +
              "\nTP1:   " + str.tostring(long_tp1, "#.##") +
              "\nTP2:   " + str.tostring(long_tp2, "#.##"),
         color=color.new(#00C853, 10),
         textcolor=color.white,
         style=label.style_label_up,
         size=size.small)

if short_condition and show_labels
    lbl = label.new(bar_index, high + atr,
         text="SHORT\nEntry: " + str.tostring(close,     "#.##") +
              "\nSL:    " + str.tostring(short_sl,  "#.##") +
              "\nTP1:   " + str.tostring(short_tp1, "#.##") +
              "\nTP2:   " + str.tostring(short_tp2, "#.##"),
         color=color.new(#D50000, 10),
         textcolor=color.white,
         style=label.style_label_down,
         size=size.small)

// ─── BACKGROUND HIGHLIGHT when price is in EMA touch zone ─────────────────────
in_long_zone  = ema_rising  and low_near_ema  and close > ema20
in_short_zone = ema_falling and high_near_ema and close < ema20
bgcolor(in_long_zone  ? color.new(#00C853, 90) : na, title="Potential Long Zone")
bgcolor(in_short_zone ? color.new(#D50000, 90) : na, title="Potential Short Zone")

// ─── INFO TABLE ──────────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 6,
     border_width=1, border_color=color.gray,
     bgcolor=color.new(color.black, 70))

if barstate.islast
    table.cell(info, 0, 0, "EMA 20 Pullback",  text_color=color.white, bgcolor=color.new(#1565C0,20), text_size=size.small)
    table.cell(info, 1, 0, syminfo.ticker,      text_color=color.yellow, bgcolor=color.new(#1565C0,20), text_size=size.small)
    table.cell(info, 0, 1, "EMA20",       text_color=color.gray,  text_size=size.small)
    table.cell(info, 1, 1, str.tostring(ema20, "#.##"), text_color=ema_color, text_size=size.small)
    table.cell(info, 0, 2, "RSI(14)",     text_color=color.gray,  text_size=size.small)
    table.cell(info, 1, 2, str.tostring(rsi, "#.#"), text_color=rsi > 70 ? color.red : rsi < 30 ? color.green : color.white, text_size=size.small)
    table.cell(info, 0, 3, "Trend",       text_color=color.gray,  text_size=size.small)
    table.cell(info, 1, 3, ema_rising ? "▲ UP" : ema_falling ? "▼ DOWN" : "── FLAT",
         text_color=ema_rising ? color.green : ema_falling ? color.red : color.gray, text_size=size.small)
    table.cell(info, 0, 4, "Daily EMA",   text_color=color.gray,  text_size=size.small)
    table.cell(info, 1, 4, htf_long ? "▲ BULL" : htf_short ? "▼ BEAR" : "FLAT",
         text_color=htf_long ? color.green : color.red, text_size=size.small)
    table.cell(info, 0, 5, "Vol vs Avg",  text_color=color.gray,  text_size=size.small)
    table.cell(info, 1, 5, str.tostring(math.round(volume / vol_avg * 100)) + "%",
         text_color=vol_ok ? color.green : color.red, text_size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(long_condition,  "EMA20 Long Entry",
     "✅ {{ticker}} EMA20 Pullback LONG @ {{close}} | SL below {{low}} | 4h")
alertcondition(short_condition, "EMA20 Short Entry",
     "✅ {{ticker}} EMA20 Pullback SHORT @ {{close}} | SL above {{high}} | 4h")
alertcondition(in_long_zone and not long_condition,  "EMA20 Long Zone (Watch)",
     "⚠️ {{ticker}} touching EMA20 from above — watch for long entry")
alertcondition(in_short_zone and not short_condition, "EMA20 Short Zone (Watch)",
     "⚠️ {{ticker}} touching EMA20 from below — watch for short entry")
